{
  "name": "quiz-solver-ext",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node tools/build-extension.mjs",
    "analytics:server": "node analytics-server/index.mjs",
    "build:raw": "vite build",
    "lint": "eslint src analytics-server e2e playwright.config.ts tools/build-extension.mjs eslint.config.mjs",
    "lint:fix": "eslint src analytics-server e2e playwright.config.ts tools/build-extension.mjs eslint.config.mjs --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run typecheck && npm run test:run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tooling.json",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs",
    "test:ui": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs --ui",
    "test:run": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.260",
    "@types/node": "^24.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.3.4",
    "vite-plugin-web-extension": "^4.1.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
