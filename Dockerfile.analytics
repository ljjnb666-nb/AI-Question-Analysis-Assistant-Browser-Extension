ARG BASE_IMAGE=node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

FROM ${BASE_IMAGE} AS admin-builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY admin-console ./admin-console
COPY vite.admin.config.ts tsconfig.json tsconfig.tooling.json ./
COPY tools/verify-admin-artifact.mjs ./tools/verify-admin-artifact.mjs
RUN npm run build:admin && npm run verify:admin

FROM ${BASE_IMAGE}
WORKDIR /app
ENTRYPOINT []

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY analytics-server ./analytics-server
COPY --from=admin-builder /app/dist-admin ./dist-admin

ENV NODE_ENV=production
ENV ANALYTICS_HOST=0.0.0.0
ENV ANALYTICS_PORT=8787
EXPOSE 8787

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then((res)=>process.exit(res.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "analytics-server/index.mjs"]
